{
  "recall_system": {
    "mode": "camera",
    "input_video": null,
    "top_n": 5,
    "match_every": 60,
    "match_interval": 2.0,
    "match_playback_duration": 2.0,
    "similarity_metric": "euclidean",
    "confidence_threshold": 0.5,
    "normalize_rotation": false,
    "max_cache_size": 1000,
    "parallel_workers": 4,
    "video_player": "opencv"
  },
  "paths": {
    "pose_dir": "data/poses",
    "video_dir": "data/video",
    "video_with_pose_dir": "data/video_with_pose"
  },
  "osc_streaming": {
    "enabled": true,
    "stream_rate": 30.0,
    "streams": {
      "pose_data": {
        "enabled": true,
        "host": "127.0.0.1",
        "port": 6448,
        "address": "/pose/data",
        "z_filter": {
          "velocity_fast_rise": 0.8,
          "velocity_slow_decay": 0.95,
          "acceleration_fast_rise": 0.9,
          "acceleration_slow_decay": 0.98
        }
      },
      "pose_data_duplicate": {
        "enabled": true,
        "host": "127.0.0.1",
        "port": 1234,
        "address": "/pose/data",
        "z_filter": {
          "velocity_fast_rise": 0.8,
          "velocity_slow_decay": 0.95,
          "acceleration_fast_rise": 0.9,
          "acceleration_slow_decay": 0.98
        }
      },
      "raw_pose_landmarks": {
        "enabled": true,
        "host": "127.0.0.1",
        "port": 6448,
        "address": "/pose/raw_landmarks",
        "include_confidence": true
      }
    }
  },
  "video_matching": {
    "load_specific_videos": false,
    "specific_videos": [
      "Jawa.MOV",
      "Dai3.mp4",
      "Francine.MOV"
    ],
    "video_extensions": [".mp4", ".avi", ".mov", ".mkv", ".webm"],
    "exclude_patterns": [
      "*_test.mp4",
      "*_draft.mp4",
      "temp_*"
    ],
    "include_patterns": [
      "*_final.mp4",
      "*_performance.mp4"
    ]
  },
  "joint_weights": {
    "nose": 1.0,
    "left_eye": 0.8,
    "right_eye": 0.8,
    "left_ear": 0.8,
    "right_ear": 0.8,
    "left_shoulder": 1.2,
    "right_shoulder": 1.2,
    "left_elbow": 1.0,
    "right_elbow": 1.0,
    "left_wrist": 0.8,
    "right_wrist": 0.8,
    "left_hip": 1.2,
    "right_hip": 1.2,
    "left_knee": 1.0,
    "right_knee": 1.0,
    "left_ankle": 0.8,
    "right_ankle": 0.8
  },
  "performance": {
    "enable_caching": true,
    "cache_cleanup_interval": 300,
    "max_memory_usage_mb": 1024,
    "enable_profiling": false
  }
}
